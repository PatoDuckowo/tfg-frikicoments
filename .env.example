# Copia este archivo como .env y rellena los valores. El .env nunca se sube a Git.
# Con Docker, docker-compose.yml fija por su cuenta PORT, HOST, DB_HOST y DB_PORT.

PORT=3000

# MySQL. Con Docker, DB_USER no puede ser root: la imagen de MySQL crea este usuario para la web.
DB_HOST=localhost
DB_PORT=3306
DB_USER=frikicoments
DB_PASSWORD=
DB_NAME=frikicoments
# Solo con Docker: contraseña de root de MySQL. Si se deja vacía, se usa DB_PASSWORD.
MYSQL_ROOT_PASSWORD=

# Superadministrador (lo crea npm run db:init)
LOGIN_USERNAME=tu_usuario
LOGIN_PASSWORD=tu_contrasena

# API de IGDB: credenciales de una aplicación registrada en https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Clave del cifrado en reposo del chat: 32 bytes en base64 (ver README). Nunca la subas a Git.
CHAT_ENCRYPTION_KEY=
